# Copier ce fichier en .env et changer les valeurs avant toute installation réelle.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangezMoi-2026
# Jeton du compte admin.securite (Element > Paramètres > Aide et à propos > Jeton d'accès)
SYNAPSE_ADMIN_TOKEN=
# Secret du client en lecture seule par lequel Synapse lit l'annuaire (identique côté Keycloak et Synapse)
KEYCLOAK_ANNUAIRE_SECRET=Demo-Annuaire-2026
