# ponytail: HTTP en local (les navigateurs traitent *.localhost comme sûr).
# En production : remplacer par les vrais domaines, Caddy active alors HTTPS automatiquement
# (ou "tls internal" avec l'autorité de certification de l'État).
{
	auto_https off
}

# chat2 : second accès au même client, pour faire tourner deux agents côte à côte (démo, tests).
http://chat.localhost, http://chat2.localhost {
	reverse_proxy element:80
}

http://matrix.localhost {
	# L'API d'administration n'est jamais exposée : seul l'outil interne y accède.
	respond /_synapse/admin/* 403
	reverse_proxy synapse:8008
}

http://auth.localhost {
	# Console d'administration jamais exposée : accessible seulement sur le poste serveur (localhost:8081).
	respond /admin* 403
	respond /realms/master* 403
	reverse_proxy keycloak:8080
}
