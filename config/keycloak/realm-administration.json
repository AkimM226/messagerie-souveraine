{
  "realm": "administration",
  "displayName": "Administration publique — infrastructure de l'État",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "loginTheme": "souverain",
  "localizationTexts": { "fr": { "loginAccountTitle": "Connexion agent", "usernameOrEmail": "Identifiant",
    "differentUserAuthenticated": "Une autre session est encore ouverte dans ce navigateur. Fermez toutes ses fenêtres, puis reconnectez-vous." } },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "CODE_TO_TOKEN_ERROR", "UPDATE_TOTP", "REMOVE_TOTP",
                        "UPDATE_PASSWORD", "USER_DISABLED_BY_TEMPORARY_LOCKOUT", "USER_DISABLED_BY_PERMANENT_LOCKOUT"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 2592000,
  "browserFlow": "navigateur-2fa",
  "authenticationFlows": [
    {
      "alias": "navigateur-2fa",
      "description": "Mot de passe ET code TOTP exigés à chaque connexion : ni OTP conditionnel, ni session réutilisée (poste partagé)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorFlow": true, "flowAlias": "formulaires-2fa", "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "formulaires-2fa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    }
  ],
  "roles": {
    "realm": [
      { "name": "agent", "description": "Agent public enrôlé : accès à la messagerie" },
      { "name": "responsable", "description": "Crée les salons classifiés et transmet les communications administratives" },
      {
        "name": "admin-securite",
        "description": "Administrateur : enrôle, modifie et révoque les agents, consulte le journal (console du realm)",
        "composite": true,
        "composites": { "client": { "realm-management": ["manage-users", "view-users", "query-users", "view-events"] } }
      }
    ]
  },
  "clients": [
    {
      "clientId": "synapse",
      "name": "Messagerie souveraine",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://matrix.localhost/_synapse/client/oidc/callback"],
      "webOrigins": ["https://matrix.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://chat.localhost/*##https://chat2.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "synapse-annuaire",
      "name": "Synapse : lecture de l'annuaire",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_ANNUAIRE_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": { "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Identifiant\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Courriel\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"Prénom\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Nom\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"ministere\",\"displayName\":\"Ministère\",\"validations\":{\"length\":{\"max\":120}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"direction\",\"displayName\":\"Direction / service\",\"validations\":{\"length\":{\"max\":120}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"fonction\",\"displayName\":\"Fonction\",\"validations\":{\"length\":{\"max\":120}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"] }
      }
    ]
  },
  "users": [
    {
      "username": "service-account-synapse-annuaire",
      "enabled": true,
      "serviceAccountClientId": "synapse-annuaire",
      "clientRoles": { "realm-management": ["view-users", "query-users", "view-realm"] }
    },
    {
      "username": "admin.securite",
      "firstName": "Responsable",
      "lastName": "Sécurité",
      "email": "admin.securite@demo.invalid",
      "emailVerified": true,
      "enabled": true,
      "attributes": { "ministere": ["MTDPCE"], "direction": ["Direction des systèmes d'information"], "fonction": ["Administrateur sécurité"] },
            "realmRoles": ["agent", "admin-securite"],
